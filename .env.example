# Ornàment Environment Configuration
ORNAMENT_ENV=development
ORNAMENT_LOG_LEVEL=INFO

# Model Configuration
# Providers: ollama | openai_compatible | transformers | mock
ORNAMENT_MODEL_PROVIDER=openai_compatible
ORNAMENT_MODEL_NAME=Qwen/Qwen2.5-Coder-7B-Instruct
ORNAMENT_MODEL_API_BASE=http://localhost:11434/v1
ORNAMENT_MODEL_API_KEY=local-key-not-required
ORNAMENT_CONTEXT_WINDOW=8192

# Hardware & Resource Limits (tailored for RTX 3050 6GB Laptop GPU + 16GB RAM)
ORNAMENT_MAX_CONCURRENT_AGENTS=2
ORNAMENT_MAX_AGENT_DEPTH=3
ORNAMENT_MIN_FREE_RAM_MB=2048
ORNAMENT_MIN_FREE_VRAM_MB=1024
ORNAMENT_DEFAULT_COMMAND_TIMEOUT_SEC=120

# Server & Workspace Settings
ORNAMENT_PORT=5050
ORNAMENT_WORKSPACE_DIR=./workspace
ORNAMENT_DATABASE_URL=sqlite:///./.ornament/ornament.db
